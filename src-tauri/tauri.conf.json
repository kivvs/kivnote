{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KivNote",
  "version": "3.3.0",
  "identifier": "io.github.kivvs.kivnote",
  "build": {
    "frontendDist": "../renderer",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KivNote",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "resources": {}
  }
}
